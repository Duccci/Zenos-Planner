{
  "name": "zenos-planner",
  "version": "0.4.0",
  "description": "Progressively approach project completion through iterative gates inspired by Zeno's paradox",
  "keywords": [
    "project-planning",
    "ai",
    "llm",
    "zeno",
    "gates",
    "requirements",
    "architecture",
    "cli"
  ],
  "homepage": "https://github.com/yourusername/zenos-planner",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/zenos-planner"
  },
  "license": "MIT",
  "author": "Zeno's Planner Contributors",
  "type": "module",
  "bin": {
    "zeno": "./bin/zeno.js"
  },
  "files": [
    "dist",
    "bin",
    "templates",
    "!dist/**/*.test.js",
    "!dist/**/__tests__",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "dev:cli": "npm run build && zeno",
    "mcp-server": "node --loader ts-node/esm src/mcp/server.ts",
    "lint": "eslint src/ --max-warnings 0",
    "lint:fix": "eslint src/ --fix --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "validate-guardrails": "npx ts-node scripts/validate-guardrail-coverage.ts",
    "ci": "npm run typecheck && npm run lint && npm run validate-guardrails && npm run test",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm run clean"
  },
  "dependencies": {
    "@babel/parser": "^7.26.0",
    "@babel/traverse": "^7.26.0",
    "@inquirer/prompts": "^7.8.0",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "better-sqlite3": "^12.0.0",
    "chalk": "^5.5.0",
    "commander": "^14.0.0",
    "glob": "^11.0.0",
    "graphviz": "^0.0.9",
    "js-yaml": "^4.1.0",
    "ora": "^8.2.0",
    "simple-git": "^3.27.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@eslint/js": "^9.0.0",
    "@types/babel__traverse": "^7.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "@vitest/ui": "^4.0.0",
    "c8": "^10.0.0",
    "dependency-cruiser": "^16.0.0",
    "eslint": "^10.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
