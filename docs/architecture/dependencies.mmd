graph LR
    subgraph "Multi-Repo Project"
        subgraph "Main Application Repo"
            MainApp[Main Application]
            AuthModule[Auth Module]
            APIModule[API Module]
            UIModule[UI Module]
        end
        
        subgraph "Shared Library Repo"
            CoreLib[Core Library]
            UtilsLib[Utils Library]
            TypesLib[Types Library]
        end
        
        subgraph "Service Repo A"
            ServiceA[User Service]
            ServiceADB[(Service A DB)]
        end
        
        subgraph "Service Repo B"
            ServiceB[Payment Service]
            ServiceBDB[(Service B DB)]
        end
    end
    
    subgraph "Dependency Tracking System"
        HashReg[Hash Registry]
        DepGraph[Dependency Graph]
        ConflictDetector[Conflict Detector]
    end
    
    %% Dependencies between modules
    MainApp -->|requires| AuthModule
    MainApp -->|requires| APIModule
    MainApp -->|requires| UIModule
    
    AuthModule -->|requires| CoreLib
    AuthModule -->|requires| TypesLib
    APIModule -->|requires| CoreLib
    APIModule -->|requires| TypesLib
    UIModule -->|requires| TypesLib
    
    CoreLib -->|requires| UtilsLib
    
    MainApp -->|calls| ServiceA
    MainApp -->|calls| ServiceB
    
    ServiceA -->|uses| CoreLib
    ServiceA -->|stores| ServiceADB
    
    ServiceB -->|uses| CoreLib
    ServiceB -->|stores| ServiceBDB
    
    %% Hash-based tracking
    AuthModule -.->|hash: a3f9c2d1| HashReg
    CoreLib -.->|hash: b7e4d8f2| HashReg
    TypesLib -.->|hash: c9a1e5b3| HashReg
    ServiceA -.->|hash: d2f7b9c4| HashReg
    
    HashReg --> DepGraph
    DepGraph --> ConflictDetector
    
    %% Example dependency with hash
    Note1[LLM Context:<br/>Requirement #a3f9c2d1<br/>depends on #b7e4d8f2]
    Note1 -.-> HashReg
    
    %% Conflict detection example
    ConflictDetector -.->|detects| Conflict[Conflict:<br/>ServiceA & ServiceB<br/>both modify CoreLib]
    
    %% Styling
    classDef repoStyle fill:#4A90E2,stroke:#2E5C8A,stroke-width:2px,color:#fff
    classDef moduleStyle fill:#50C878,stroke:#3A9B5C,stroke-width:2px,color:#fff
    classDef serviceStyle fill:#7B68EE,stroke:#5A4AB8,stroke-width:2px,color:#fff
    classDef trackingStyle fill:#FFA500,stroke:#CC8400,stroke-width:2px,color:#fff
    classDef conflictStyle fill:#FF6B6B,stroke:#CC5555,stroke-width:2px,color:#fff
    classDef dbStyle fill:#9B59B6,stroke:#7D3C98,stroke-width:2px,color:#fff
    
    class MainApp,AuthModule,APIModule,UIModule repoStyle
    class CoreLib,UtilsLib,TypesLib moduleStyle
    class ServiceA,ServiceB serviceStyle
    class HashReg,DepGraph,ConflictDetector trackingStyle
    class Conflict conflictStyle
    class ServiceADB,ServiceBDB dbStyle


