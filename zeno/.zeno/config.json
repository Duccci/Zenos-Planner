{
  "projectName": "Zenos-Planner",
  "qualityThresholds": {
    "codeCoverage": 90,
    "securityVulnerabilities": 0,
    "lintingErrorRate": 0.01,
    "typeCheckingErrors": 0
  },
  "hashAlgorithm": "sha256",
  "hashLength": 16,
  "git": {
    "autoCommit": true,
    "autoTag": true,
    "autoPush": false,
    "remote": "origin",
    "commitFormat": "<type>(<scope>): <subject>\n\n<body>",
    "commitExamples": [
      "feat(gate): archive core-infrastructure gate with 3 proposals",
      "chore(proposal): archive database-setup proposal with migration scripts",
      "chore(proposal): archive solitary proposal - template loader infrastructure"
    ]
  },
  "versioning": {
    "enabled": true,
    "proposalBump": "patch",
    "gateBump": "minor",
    "lifecycleBump": "major"
  }
}

