{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://zenos-planner.com/schemas/repo-map.schema.json",
  "title": "Repository Map Schema",
  "description": "Schema for validating repository mapping files used by Zeno's Planner for multi-repository project management",
  "type": "object",
  "properties": {
    "repositories": {
      "type": "array",
      "description": "List of repositories in the project",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Repository name",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "description": "Repository URL",
            "format": "uri"
          },
          "path": {
            "type": "string",
            "description": "Local path to repository",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "description": "Repository type",
            "enum": ["primary", "secondary", "dependency", "tool"]
          },
          "description": {
            "type": "string",
            "description": "Optional description of the repository's purpose"
          }
        },
        "required": ["name", "url", "path", "type"],
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "object",
      "description": "Cross-repository dependencies mapping",
      "patternProperties": {
        "^[a-f0-9]{16}$": {
          "type": "array",
          "description": "List of requirement hashes that this repository depends on",
          "items": {
            "type": "string",
            "description": "Requirement hash",
            "pattern": "^[a-f0-9]{16}$"
          }
        }
      },
      "additionalProperties": false
    },
    "lastUpdated": {
      "type": "string",
      "description": "ISO 8601 timestamp of last update",
      "format": "date-time"
    }
  },
  "required": ["repositories", "dependencies", "lastUpdated"],
  "additionalProperties": false
}