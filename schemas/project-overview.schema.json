{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Zeno's Planner Project Overview Schema",
  "description": "JSON schema for project-overview.json - LLM-optimized project memory file",
  "type": "object",
  "properties": {
    "projectName": {
      "type": "string",
      "description": "Human-readable project name"
    },
    "projectVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version string (e.g., '0.2.0')"
    },
    "currentGate": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Currently active gate sequence number (null if no active gate)"
    },
    "totalGatesPlanned": {
      "type": "integer",
      "minimum": 1,
      "description": "Total number of gates planned for project completion"
    },
    "endState": {
      "type": "string",
      "description": "Final project vision and goals"
    },
    "startState": {
      "type": ["string", "null"],
      "description": "Initial project state (null for new projects)"
    },
    "completedGates": {
      "type": "array",
      "description": "Array of completed gates with essential information",
      "items": {
        "type": "object",
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "description": "Gate sequence number"
          },
          "name": {
            "type": "string",
            "description": "Human-readable gate name"
          },
          "hash": {
            "type": "string",
            "pattern": "^#[a-f0-9]{16}$",
            "description": "16-character SHA-256 hash for gate reference"
          },
          "completedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Date when gate was completed (YYYY-MM-DD format)"
          },
          "status": {
            "type": "string",
            "enum": ["completed"],
            "description": "Gate status (only completed gates appear here)"
          }
        },
        "required": ["sequence", "name", "hash", "completedAt", "status"]
      }
    },
    "currentGateInfo": {
      "type": "object",
      "description": "Information about the currently active or next pending gate",
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "description": "Gate sequence number"
        },
        "name": {
          "type": "string",
          "description": "Human-readable gate name"
        },
        "hash": {
          "type": "string",
          "pattern": "^#[a-f0-9]{16}$",
          "description": "16-character SHA-256 hash for gate reference"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "in_progress"],
          "description": "Current gate status"
        },
        "estimatedComplexity": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "description": "Estimated complexity level of the gate"
        }
      },
      "required": ["sequence", "name", "hash", "status", "estimatedComplexity"]
    },
    "upcomingGates": {
      "type": "array",
      "description": "Preview of upcoming gates",
      "items": {
        "type": "object",
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "description": "Gate sequence number"
          },
          "name": {
            "type": "string",
            "description": "Human-readable gate name"
          },
          "estimatedComplexity": {
            "type": "string",
            "enum": ["low", "medium", "high"],
            "description": "Estimated complexity level"
          }
        },
        "required": ["sequence", "name", "estimatedComplexity"]
      }
    },
    "architecture": {
      "type": "object",
      "description": "High-level architecture overview",
      "properties": {
        "layers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "System architecture layers"
        },
        "keyDependencies": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "string",
              "pattern": "^\\^?\\d+\\.\\d+\\.\\d+$"
            }
          },
          "description": "Key package dependencies with version constraints"
        }
      },
      "required": ["layers", "keyDependencies"]
    }
  },
  "required": [
    "projectName", "projectVersion", "currentGate", "totalGatesPlanned",
    "endState", "startState", "completedGates", "currentGateInfo",
    "upcomingGates", "architecture"
  ]
}